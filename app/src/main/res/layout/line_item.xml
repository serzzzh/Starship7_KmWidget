<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#1AFFFFFF"
    android:layout_marginBottom="8dp">

    <!-- Container that visually rearanges checkboxes to show the order -->
    <LinearLayout
        android:id="@+id/checkboxesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <CheckBox
            android:id="@+id/cbText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Текст"
            android:textColor="#EEEEEE"
            android:textSize="16sp"
            android:minWidth="0dp"
            android:layout_marginEnd="12dp" />
        <CheckBox
            android:id="@+id/cbSum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сумма"
            android:textColor="#EEEEEE"
            android:textSize="16sp"
            android:minWidth="0dp"
            android:layout_marginEnd="12dp" />
        <CheckBox
            android:id="@+id/cbBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="АКБ"
            android:textColor="#EEEEEE"
            android:textSize="16sp"
            android:minWidth="0dp"
            android:layout_marginEnd="12dp" />
        <CheckBox
            android:id="@+id/cbFuel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Бензин"
            android:textColor="#EEEEEE"
            android:textSize="16sp"
            android:minWidth="0dp"
            android:layout_marginEnd="12dp" />
        <CheckBox
            android:id="@+id/cbMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Режим"
            android:textColor="#EEEEEE"
            android:textSize="16sp"
            android:minWidth="0dp"
            android:layout_marginEnd="12dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginVertical="2dp" />

    <!-- Container for Options to reorder them vertically based on selection order -->
    <LinearLayout
        android:id="@+id/optionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ─── Опции Текста ────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layTextOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:minHeight="40dp">
            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Текст:"
                android:textColor="#AAA"
                android:textSize="14sp" />
            <EditText
                android:id="@+id/etTextValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Текст"
                android:textColor="#FFF"
                android:textColorHint="#666"
                android:textSize="16sp"
                android:backgroundTint="#555"
                android:padding="4dp" />
            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="#555"
                android:layout_marginHorizontal="6dp" />
            <Spinner
                android:id="@+id/spinTextSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ─── Опции Суммы ─────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/laySumOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:minHeight="40dp">
            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Сумма:"
                android:textColor="#AAA"
                android:textSize="14sp" />
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="#555"
                android:layout_marginHorizontal="6dp" />
            <Spinner
                android:id="@+id/spinSumSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ─── Опции АКБ ──────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layBatOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:minHeight="40dp">
            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="АКБ:"
                android:textColor="#AAA"
                android:textSize="14sp" />
            <RadioGroup
                android:id="@+id/rgBatDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/rbBatKm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="км"
                    android:textColor="#CCC"
                    android:textSize="14sp"
                    android:minWidth="0dp" />
                <RadioButton
                    android:id="@+id/rbBatPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textColor="#CCC"
                    android:textSize="14sp"
                    android:minWidth="0dp"
                    android:layout_marginStart="6dp" />
            </RadioGroup>
            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="#555"
                android:layout_marginHorizontal="6dp" />
            <Spinner
                android:id="@+id/spinBatSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ─── Опции Бензина ──────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layFuelOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:minHeight="40dp">
            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Бензин:"
                android:textColor="#AAA"
                android:textSize="14sp" />
            <RadioGroup
                android:id="@+id/rgFuelDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/rbFuelKm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="км"
                    android:textColor="#CCC"
                    android:textSize="14sp"
                    android:minWidth="0dp" />
                <RadioButton
                    android:id="@+id/rbFuelLiters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="л"
                    android:textColor="#CCC"
                    android:textSize="14sp"
                    android:minWidth="0dp"
                    android:layout_marginStart="6dp" />
                <RadioButton
                    android:id="@+id/rbFuelPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textColor="#CCC"
                    android:textSize="14sp"
                    android:minWidth="0dp"
                    android:layout_marginStart="6dp" />
            </RadioGroup>
            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="#555"
                android:layout_marginHorizontal="6dp" />
            <Spinner
                android:id="@+id/spinFuelSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ─── Опции Режима ────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layModeOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:minHeight="40dp">
            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Режим:"
                android:textColor="#AAA"
                android:textSize="14sp" />
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="#555"
                android:layout_marginHorizontal="6dp" />
            <Spinner
                android:id="@+id/spinModeSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginVertical="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">
        <Button
            android:id="@+id/btnDeleteEntry"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="✕"
            android:textSize="18sp"
            android:textColor="#FF6666"
            android:background="@android:color/transparent"
            android:padding="4dp" />
    </LinearLayout>
</LinearLayout>
