<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#1AFFFFFF"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        
        <CheckBox
            android:id="@+id/cbText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Текст"
            android:textColor="#EEEEEE"
            android:textSize="12sp"
            android:minWidth="0dp" />

        <CheckBox
            android:id="@+id/cbSum"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Сумма"
            android:textColor="#EEEEEE"
            android:textSize="12sp"
            android:minWidth="0dp" />

        <CheckBox
            android:id="@+id/cbBattery"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="АКБ"
            android:textColor="#EEEEEE"
            android:textSize="12sp"
            android:minWidth="0dp" />

        <CheckBox
            android:id="@+id/cbFuel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Бензин"
            android:textColor="#EEEEEE"
            android:textSize="12sp"
            android:minWidth="0dp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginVertical="2dp" />

    <!-- ─── Опции Текста ────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layTextOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:minHeight="32dp">
        <TextView android:layout_width="45dp" android:layout_height="wrap_content" android:text="Текст:" android:textColor="#AAA" android:textSize="11sp"/>
        <EditText
            android:id="@+id/etTextValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Текст"
            android:textColor="#FFF"
            android:textColorHint="#666"
            android:textSize="12sp"
            android:backgroundTint="#555"
            android:padding="4dp" />
        <View android:layout_width="1dp" android:layout_height="16dp" android:background="#555" android:layout_marginHorizontal="4dp" />
        <RadioGroup android:id="@+id/rgTextSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbTextS" layout_width="wrap_content" layout_height="wrap_content" text="S" textColor="#CCC" textSize="11sp" minWidth="0dp"/>
            <RadioButton android:id="@+id/rbTextM" layout_width="wrap_content" layout_height="wrap_content" text="M" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
            <RadioButton android:id="@+id/rbTextL" layout_width="wrap_content" layout_height="wrap_content" text="L" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
            <RadioButton android:id="@+id/rbTextXL" layout_width="wrap_content" layout_height="wrap_content" text="XL" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
        </RadioGroup>
    </LinearLayout>

    <!-- ─── Опции Суммы ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/laySumOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:minHeight="32dp">
        <TextView android:layout_width="45dp" android:layout_height="wrap_content" android:text="Сумма:" android:textColor="#AAA" android:textSize="11sp"/>
        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <View android:layout_width="1dp" android:layout_height="16dp" android:background="#555" android:layout_marginHorizontal="4dp" />
        <RadioGroup android:id="@+id/rgSumSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbSumS" layout_width="wrap_content" layout_height="wrap_content" text="S" textColor="#CCC" textSize="11sp" minWidth="0dp"/>
            <RadioButton android:id="@+id/rbSumM" layout_width="wrap_content" layout_height="wrap_content" text="M" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
            <RadioButton android:id="@+id/rbSumL" layout_width="wrap_content" layout_height="wrap_content" text="L" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
            <RadioButton android:id="@+id/rbSumXL" layout_width="wrap_content" layout_height="wrap_content" text="XL" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
        </RadioGroup>
    </LinearLayout>

    <!-- ─── Опции АКБ ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layBatOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:minHeight="32dp">
        <TextView android:layout_width="45dp" android:layout_height="wrap_content" android:text="АКБ:" android:textColor="#AAA" android:textSize="11sp"/>
        <RadioGroup android:id="@+id/rgBatDisplay" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbBatKm" layout_width="wrap_content" layout_height="wrap_content" text="км" textColor="#CCC" textSize="11sp" minWidth="0dp"/>
            <RadioButton android:id="@+id/rbBatPercent" layout_width="wrap_content" layout_height="wrap_content" text="%" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="4dp"/>
        </RadioGroup>
        <View android:layout_width="1dp" android:layout_height="16dp" android:background="#555" android:layout_marginHorizontal="4dp" />
        <RadioGroup android:id="@+id/rgBatSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbBatS" layout_width="wrap_content" layout_height="wrap_content" text="S" textColor="#CCC" textSize="11sp" minWidth="0dp"/>
            <RadioButton android:id="@+id/rbBatM" layout_width="wrap_content" layout_height="wrap_content" text="M" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
            <RadioButton android:id="@+id/rbBatL" layout_width="wrap_content" layout_height="wrap_content" text="L" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
            <RadioButton android:id="@+id/rbBatXL" layout_width="wrap_content" layout_height="wrap_content" text="XL" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
        </RadioGroup>
    </LinearLayout>

    <!-- ─── Опции Бензина ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layFuelOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:minHeight="32dp">
        <TextView android:layout_width="45dp" android:layout_height="wrap_content" android:text="Бензин:" android:textColor="#AAA" android:textSize="11sp"/>
        <RadioGroup android:id="@+id/rgFuelDisplay" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbFuelKm" layout_width="wrap_content" layout_height="wrap_content" text="км" textColor="#CCC" textSize="11sp" minWidth="0dp"/>
            <RadioButton android:id="@+id/rbFuelLiters" layout_width="wrap_content" layout_height="wrap_content" text="л" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="4dp"/>
            <RadioButton android:id="@+id/rbFuelPercent" layout_width="wrap_content" layout_height="wrap_content" text="%" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="4dp"/>
        </RadioGroup>
        <View android:layout_width="1dp" android:layout_height="16dp" android:background="#555" android:layout_marginHorizontal="4dp" />
        <RadioGroup android:id="@+id/rgFuelSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbFuelS" layout_width="wrap_content" layout_height="wrap_content" text="S" textColor="#CCC" textSize="11sp" minWidth="0dp"/>
            <RadioButton android:id="@+id/rbFuelM" layout_width="wrap_content" layout_height="wrap_content" text="M" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
            <RadioButton android:id="@+id/rbFuelL" layout_width="wrap_content" layout_height="wrap_content" text="L" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
            <RadioButton android:id="@+id/rbFuelXL" layout_width="wrap_content" layout_height="wrap_content" text="XL" textColor="#CCC" textSize="11sp" minWidth="0dp" layout_marginStart="2dp"/>
        </RadioGroup>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginVertical="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">
        <Button
            android:id="@+id/btnDeleteEntry"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✕"
            android:textSize="14sp"
            android:textColor="#FF6666"
            android:background="@android:color/transparent"
            android:padding="4dp" />
    </LinearLayout>
</LinearLayout>
