<?xml version="1.0" encoding="utf-8"?>
<!-- Одна запись: батарея + топливо с независимыми настройками -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#11FFFFFF"
    android:padding="8dp"
    android:layout_marginBottom="6dp">

    <!-- ── Строка батареи ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <CheckBox
            android:id="@+id/cbBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋 Батарея"
            android:textSize="14sp"
            android:checked="true"
            android:minWidth="0dp"
            android:layout_marginEnd="8dp" />

        <!-- Опции батареи (прячутся при снятии галочки) -->
        <LinearLayout
            android:id="@+id/layBatOptions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <RadioGroup
                android:id="@+id/rgBatDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginEnd="8dp">
                <RadioButton android:id="@+id/rbBatKm"  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="км"
                    android:textSize="13sp" android:checked="true"
                    android:layout_marginEnd="4dp" />
                <RadioButton android:id="@+id/rbBatPct" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="%"
                    android:textSize="13sp" />
            </RadioGroup>

            <RadioGroup
                android:id="@+id/rgBatSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbBatS"  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="S"
                    android:textSize="12sp" android:layout_marginEnd="2dp" />
                <RadioButton android:id="@+id/rbBatM"  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="M"
                    android:textSize="12sp" android:checked="true"
                    android:layout_marginEnd="2dp" />
                <RadioButton android:id="@+id/rbBatL"  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="L"
                    android:textSize="12sp" android:layout_marginEnd="2dp" />
                <RadioButton android:id="@+id/rbBatXL" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="XL"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Кнопка удалить (только в строке батареи) -->
        <Button
            android:id="@+id/btnDeleteEntry"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✕"
            android:textSize="13sp"
            android:padding="0dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#663333" />
    </LinearLayout>

    <!-- ── Строка топлива ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/cbFuel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛽ Бензин"
            android:textSize="14sp"
            android:checked="true"
            android:minWidth="0dp"
            android:layout_marginEnd="8dp" />

        <!-- Опции топлива -->
        <LinearLayout
            android:id="@+id/layFuelOptions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <RadioGroup
                android:id="@+id/rgFuelDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginEnd="8dp">
                <RadioButton android:id="@+id/rbFuelKm"  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="км"
                    android:textSize="13sp" android:checked="true"
                    android:layout_marginEnd="4dp" />
                <RadioButton android:id="@+id/rbFuelPct" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="%"
                    android:textSize="13sp" />
            </RadioGroup>

            <RadioGroup
                android:id="@+id/rgFuelSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbFuelS"  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="S"
                    android:textSize="12sp" android:layout_marginEnd="2dp" />
                <RadioButton android:id="@+id/rbFuelM"  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="M"
                    android:textSize="12sp" android:checked="true"
                    android:layout_marginEnd="2dp" />
                <RadioButton android:id="@+id/rbFuelL"  android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="L"
                    android:textSize="12sp" android:layout_marginEnd="2dp" />
                <RadioButton android:id="@+id/rbFuelXL" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="XL"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Placeholder справа чтобы выровнять под кнопку удалить -->
        <View android:layout_width="40dp" android:layout_height="1dp" />
    </LinearLayout>

</LinearLayout>
