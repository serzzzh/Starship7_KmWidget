<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#1AFFFFFF"
    android:layout_marginBottom="6dp">

    <!-- ═══ Строка батареи ══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="36dp">

        <CheckBox
            android:id="@+id/cbBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋 Батарея"
            android:textColor="#EEEEEE"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:paddingStart="4dp" />

        <!-- Опции батареи: вид + разделитель + размер -->
        <LinearLayout
            android:id="@+id/layBatOptions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="6dp">

            <!-- Единицы батареи: км | % -->
            <RadioGroup
                android:id="@+id/rgBatDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbBatKm"      android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="км"  android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp"/>
                <RadioButton android:id="@+id/rbBatPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="%"   android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp" android:layout_marginStart="4dp"/>
            </RadioGroup>

            <!-- Разделитель: единицы ↔ размер -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="#555555"
                android:layout_marginHorizontal="6dp" />

            <!-- Размер батареи: S M L XL -->
            <RadioGroup
                android:id="@+id/rgBatSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbBatS"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S"  android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp"/>
                <RadioButton android:id="@+id/rbBatM"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M"  android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp" android:layout_marginStart="4dp"/>
                <RadioButton android:id="@+id/rbBatL"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L"  android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp" android:layout_marginStart="4dp"/>
                <RadioButton android:id="@+id/rbBatXL" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XL" android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp" android:layout_marginStart="4dp"/>
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>

    <!-- ─── Разделитель между батареей и бензином ─────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginVertical="4dp" />

    <!-- ═══ Строка бензина ══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="36dp">

        <CheckBox
            android:id="@+id/cbFuel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛽ Бензин"
            android:textColor="#EEEEEE"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:paddingStart="4dp" />

        <!-- Опции бензина: вид + разделитель + размер -->
        <LinearLayout
            android:id="@+id/layFuelOptions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="6dp">

            <!-- Единицы бензина: км | л | % -->
            <RadioGroup
                android:id="@+id/rgFuelDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbFuelKm"     android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="км" android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp"/>
                <RadioButton android:id="@+id/rbFuelLiters"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="л"  android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp" android:layout_marginStart="4dp"/>
                <RadioButton android:id="@+id/rbFuelPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="%"  android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp" android:layout_marginStart="4dp"/>
            </RadioGroup>

            <!-- Разделитель: единицы ↔ размер -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="#555555"
                android:layout_marginHorizontal="6dp" />

            <!-- Размер бензина: S M L XL -->
            <RadioGroup
                android:id="@+id/rgFuelSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbFuelS"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S"  android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp"/>
                <RadioButton android:id="@+id/rbFuelM"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M"  android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp" android:layout_marginStart="4dp"/>
                <RadioButton android:id="@+id/rbFuelL"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L"  android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp" android:layout_marginStart="4dp"/>
                <RadioButton android:id="@+id/rbFuelXL" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="XL" android:textColor="#CCC" android:textSize="12sp" android:minWidth="0dp" android:layout_marginStart="4dp"/>
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>

    <!-- ─── Разделитель перед нижней строкой ───────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginVertical="4dp" />

    <!-- ═══ Нижняя строка: «На одной строке» + удалить ════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/cbCombine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="На одной строке"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:paddingStart="4dp" />

        <Button
            android:id="@+id/btnDeleteEntry"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✕"
            android:textSize="14sp"
            android:textColor="#FF6666"
            android:background="@android:color/transparent"
            android:padding="4dp" />
    </LinearLayout>

</LinearLayout>
