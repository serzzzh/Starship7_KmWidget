<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Превью -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#22000000"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_title"
                android:textSize="12sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/textRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- km"
                android:textColor="#00AA00"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/textInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="..."
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ══ Окно расчёта ════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_config_title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_time"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioKm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_km"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <EditText
            android:id="@+id/editValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/widget_config_hint"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- ══ Настройки отображения оверлея ══════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_display_title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Строка 1: Общий запас хода -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_line_total"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <RadioButton android:id="@+id/rgTotalOff" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/size_off" />
            <RadioButton android:id="@+id/rgTotalS" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="S" />
            <RadioButton android:id="@+id/rgTotalM" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="M" />
            <RadioButton android:id="@+id/rgTotalL" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="L" android:checked="true" />
            <RadioButton android:id="@+id/rgTotalXL" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="XL" />
        </RadioGroup>

        <!-- Строка 2: EV + Fuel в км -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_line_breakdown"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <RadioButton android:id="@+id/rgBdOff" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/size_off" />
            <RadioButton android:id="@+id/rgBdS" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="S" />
            <RadioButton android:id="@+id/rgBdM" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="M" android:checked="true" />
            <RadioButton android:id="@+id/rgBdL" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="L" />
            <RadioButton android:id="@+id/rgBdXL" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="XL" />
        </RadioGroup>

        <!-- Строка 3: % заряда и топлива -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_line_info"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            <RadioButton android:id="@+id/rgInfoOff" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/size_off" />
            <RadioButton android:id="@+id/rgInfoS" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="S" android:checked="true" />
            <RadioButton android:id="@+id/rgInfoM" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="M" />
            <RadioButton android:id="@+id/rgInfoL" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="L" />
            <RadioButton android:id="@+id/rgInfoXL" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="XL" />
        </RadioGroup>

        <!-- Кнопка Сохранить -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_save_settings" />

    </LinearLayout>
</ScrollView>
