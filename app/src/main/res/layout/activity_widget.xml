<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Запас хода — настройки"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Превью -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A00FF00"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Текущая оценка"
                android:textSize="11sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/textRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- км"
                android:textColor="#00AA44"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/textInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="..."
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ══ Строка «Запас хода» ════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Запас хода — размер"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <RadioGroup
            android:id="@+id/rgRangeSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            <RadioButton android:id="@+id/rgRangeS"  android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="S" android:gravity="center" />
            <RadioButton android:id="@+id/rgRangeM"  android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="M" android:gravity="center" android:checked="true" />
            <RadioButton android:id="@+id/rgRangeL"  android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="L" android:gravity="center" />
            <RadioButton android:id="@+id/rgRangeXL" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="XL" android:gravity="center" />
        </RadioGroup>

        <!-- ══ Дополнительные строки ═════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Дополнительные строки"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAddLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Добавить"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Легенда -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Источник" android:textSize="11sp" android:textColor="#888888"
                android:layout_marginEnd="16dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Стиль" android:textSize="11sp" android:textColor="#888888"
                android:layout_marginEnd="16dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Размер" android:textSize="11sp" android:textColor="#888888" />
        </LinearLayout>

        <!-- Контейнер для динамических строк -->
        <LinearLayout
            android:id="@+id/linesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp" />

        <!-- ══ Окно расчёта ══════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Окно расчёта"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/radioTime" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Последние N минут" android:checked="true" />
            <RadioButton android:id="@+id/radioKm" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Последние X км"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <EditText
            android:id="@+id/editValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Значение (минуты или км)"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Сохранить -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓  Сохранить и применить"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
