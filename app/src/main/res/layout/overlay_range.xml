<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#DD000000"
    android:minWidth="120dp">

    <!-- Основной контент -->
    <LinearLayout
        android:id="@+id/overlay_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="32dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:gravity="start">

        <!-- Заголовок -->
        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛣 Range"
            android:textColor="#666666"
            android:textSize="9sp" />

        <!-- Строка 1: Общий запас хода -->
        <TextView
            android:id="@+id/overlay_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- km"
            android:textColor="#00FF88"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <!-- Строка 2: EV + Fuel в км -->
        <TextView
            android:id="@+id/overlay_breakdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔋-- + ⛽-- km"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:layout_marginTop="1dp" />

        <!-- Строка 3: % заряда и топлива -->
        <TextView
            android:id="@+id/overlay_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="#888888"
            android:textSize="10sp"
            android:layout_marginTop="1dp" />

    </LinearLayout>

    <!-- Кнопка выключения — правый верхний угол -->
    <TextView
        android:id="@+id/overlay_power_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:text="⏻"
        android:textColor="#CC3333"
        android:textSize="16sp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="#33FF0000" />

</FrameLayout>
