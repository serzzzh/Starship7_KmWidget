<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#DD000000"
    android:minWidth="100dp">

    <!-- Основной контент -->
    <LinearLayout
        android:id="@+id/overlay_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="34dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:gravity="start">

        <!-- Заголовок (маленький) -->
        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛣 Запас хода"
            android:textColor="#555555"
            android:textSize="9sp" />

        <!-- Главная строка: итого км -->
        <TextView
            android:id="@+id/overlay_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- км"
            android:textColor="#00FF88"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="1dp" />

        <!-- Динамические дополнительные строки -->
        <LinearLayout
            android:id="@+id/overlay_lines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Кнопка выключения — правый верхний угол -->
    <TextView
        android:id="@+id/overlay_power_btn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:text="⏻"
        android:textColor="#BB2222"
        android:textSize="15sp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="#33880000" />

</FrameLayout>
